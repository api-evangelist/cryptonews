        {
          "id": "8840d8d9-0b0f-4af6-8445-9df510a0371d",
          "name": "Get Crypto News",
          "request": {
            "name": "Get Crypto News",
            "description": {
              "content": "Retrieve cryptocurrency news articles from 50+ sources. Filter by ticker symbol, include or exclude tickers, control pagination and item count per page.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "tickers",
                  "value": "<string>",
                  "description": "Comma-separated list of cryptocurrency ticker symbols to filter news by (e.g. BTC,ETH,XRP)."
                },
                {
                  "disabled": false,
                  "key": "tickers-include",
                  "value": "<string>",
                  "description": "Return only articles that mention all of the specified tickers (comma-separated). Stricter than tickers."
                },
                {
                  "disabled": false,
                  "key": "tickers-only",
                  "value": "<string>",
                  "description": "Return only articles that mention exclusively the specified ticker and no other tickers."
                },
                {
                  "disabled": false,
                  "key": "items",
                  "value": "50",
                  "description": "Number of news articles to return per page (max 50)."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for pagination (starts at 1)."
                },
                {
                  "disabled": false,
                  "key": "token",
                  "value": "<string>",
                  "description": "(Required) API authentication token."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
