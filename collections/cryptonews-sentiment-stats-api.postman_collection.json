          "request": {
            "name": "Get Sentiment Statistics",
            "description": {
              "content": "Retrieve AI-powered sentiment analysis statistics for cryptocurrency news. Filter by section (general or alltickers) or specific ticker, and specify a date range.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "stat"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "section",
                  "value": "<string>",
                  "description": "Section to get stats for. Use 'general' or 'alltickers'. Mutually exclusive with tickers parameter."
                },
                {
                  "disabled": false,
                  "key": "tickers",
                  "value": "<string>",
                  "description": "Comma-separated ticker symbols to get stats for. Mutually exclusive with section parameter."
                },
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<string>",
                  "description": "Date range for sentiment statistics."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for pagination."
                },
                {
                  "disabled": false,
                  "key": "token",
                  "value": "<string>",
                  "description": "(Required) API authentication token."
                }
              ],
              "variable": []
            },
